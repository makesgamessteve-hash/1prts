# Renders a golden scenario and compares its shots with the references. MIT License.
# -DEXE= -DCOMPARE= -DSCENARIO= -DREF= -DOUT= -DUSER= [-DDIFF=] [-DEXPECT=<image that must differ>]
file(REMOVE_RECURSE ${OUT})
file(MAKE_DIRECTORY ${OUT})
if(DIFF)
  file(REMOVE_RECURSE ${DIFF})
endif()
execute_process(COMMAND ${EXE} --size 640x360 --scenario ${SCENARIO} --out ${OUT} --user ${USER} RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "the golden scenario failed (exit ${rc})")
endif()
set(args --ref ${REF} --out ${OUT})
if(EXPECT)
  list(APPEND args --expect-mismatch ${EXPECT})
elseif(DIFF)
  list(APPEND args --diff ${DIFF})
endif()
execute_process(COMMAND ${COMPARE} ${args} RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "golden image comparison failed; difference images: ${DIFF}")
endif()
